{
  "manifest_version": 3,
  "name": "OpenKTV Quick Add",
  "version": "1.0.0",
  "description": "Click to add current page song URL to OpenKTV queue.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon_gray16.png",
    "32": "icon_gray32.png",
    "48": "icon_gray48.png",
    "128": "icon_gray128.png"
  },
  "action": {
    "default_title": "Add current song to OpenKTV",
    "default_icon": {
      "16": "icon_gray16.png",
      "32": "icon_gray32.png",
      "48": "icon_gray48.png",
      "128": "icon_gray128.png"
    }
  },
  "options_page": "options.html"
}
